# Copy this file to .env and fill in real values. Never commit .env.
APP_NAME="AI Karaoke Maker"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/aikaraoke
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aikaraoke
DB_USERNAME=root
DB_PASSWORD=

OPENAI_API_KEY=
MUSIXMATCH_API_KEY=
GENIUS_ACCESS_TOKEN=

# "Sign in with Google" — create an OAuth 2.0 Client ID (Web application)
# at https://console.cloud.google.com/apis/credentials, with
# GOOGLE_REDIRECT_URI added under "Authorized redirect URIs". Leave blank
# to disable the Google sign-in button (email/password still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/aikaraoke/auth/google/callback

SESSION_NAME=aikaraoke_session
SESSION_LIFETIME=7200

# SMTP — used to email users when a job completes/fails, and (eventually)
# purchase receipts. Leave MAIL_HOST blank to disable sending entirely: the
# app keeps working, notification emails are just skipped (logged instead)
# rather than the job pipeline failing over a missing mail config.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="AI Karaoke Maker"

# RunPod Serverless GPU processing — leave RUNPOD_API_KEY blank to keep
# using local subprocess processing (python/worker.py on this machine).
# See docs/CONFIGURATION.md's "RunPod Serverless integration" section.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Shared secret the RunPod worker sends back on every callback
# (X-Worker-Secret header) so WorkerCallbackController knows the request
# really came from your own RunPod job and not a random POST off the
# internet. Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
WORKER_API_SECRET=
