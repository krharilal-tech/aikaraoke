# The RunPod image only needs handler.py + python/ — everything else here
# is the PHP app (stays on Hostinger) or local dev/VCS cruft that would
# just slow the build down.
.git
.gitignore
app/
bin/
database/
docs/
public/
routes/
storage/
vendor/
composer.json
composer.lock
*.md

python/venv/
python/__pycache__/
python/**/__pycache__/
python/tools/
*.pyc
